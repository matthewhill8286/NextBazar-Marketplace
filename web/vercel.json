{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "react-router",
  "installCommand": "npm install",
  "buildCommand": "react-router build",
  "crons": [
    {
      "path": "/api/cron/expire-offers",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/expire-promotions",
      "schedule": "0 0 * * *"
    }
  ]
}
